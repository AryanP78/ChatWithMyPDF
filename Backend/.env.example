# --- Google AI Studio API key ---
# Get one (free, no billing) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Postgres connection string (local Docker OR a free hosted pgvector DB) ---
# We'll set this for real in Phase 3.
DATABASE_URL=postgresql://user:password@localhost:5432/askmypdf

# --- Server ---
PORT=3001

# --- Models & embedding dimension ---
# Gemini's embedding model lets us request the output size, so we pin 1536
# to match the VECTOR(1536) column the roadmap's schema uses.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-3.8-flash
EMBED_DIM=1536
